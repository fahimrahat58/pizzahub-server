# Server configuration
PORT=5000
FRONTEND_URL=http://localhost:3000

# Database (shared with the Next.js app)
MONGODB_URI=
DB_NAME=pizzahub

# Better Auth (shared with the Next.js app)
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=

# ImgBB (server-side only, used for image uploads)
IMGBB_API_KEY=

# Stripe — vendor Premium subscriptions ONLY (server-side only).
# Never expose these with a NEXT_PUBLIC_ prefix.
# Use Stripe TEST mode values during development.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# These must be Price IDs (price_...), not Product IDs (prod_...).
STRIPE_PRICE_ID_MONTHLY=
STRIPE_PRICE_ID_YEARLY=
